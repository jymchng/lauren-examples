# OpenRouter (OpenAI-compatible — default)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
LLM_MODEL=openai/gpt-4o-mini
LLM_BASE_URL=https://openrouter.ai/api/v1

# For Anthropic direct (uncomment and set LLM_MODEL to a claude model)
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_BASE_URL=

# Shared secret used to sign/verify request payloads (set to same value in frontend)
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Server port
PORT=8000
