# Lauren backend URL (server-side only — never exposed to the browser)
BACKEND_URL=http://localhost:8000

# Secret used to sign request payloads sent to the Lauren backend.
# Must match PAYLOAD_SECRET in the backend .env
PAYLOAD_SECRET=change-me-to-a-long-random-string

# WebSocket backend URL — exposed to the browser for direct WS connection.
NEXT_PUBLIC_WS_URL=ws://localhost:8000
